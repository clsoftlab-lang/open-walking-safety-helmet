[Unit]
Description=Open Walking Safety Helmet firmware
After=sound.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
# setup_pi.sh replaces @USER@ and @FIRMWARE_DIR@
User=@USER@
Group=@USER@
SupplementaryGroups=gpio i2c video audio bluetooth
WorkingDirectory=@FIRMWARE_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@FIRMWARE_DIR@/.venv/bin/python -m owsh --config @FIRMWARE_DIR@/config/default.yaml --no-window
Restart=always
RestartSec=2
# A crash must never leave the helmet silent for long: systemd restarts it after 2 s.
StartLimitIntervalSec=0
Nice=-5

[Install]
WantedBy=multi-user.target
